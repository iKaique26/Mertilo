{
  "name": "mertilo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "resources/app",
    "resources/app/api"
  ],
  "scripts": {
    "install-all": "npm install",
    "start": "npm run start --workspace resources/app",
    "dev": "concurrently \"npm run start --workspace resources/app\" \"npm run dev --workspace resources/app/api\"",
    "build": "npm run build --workspace resources/app/api",
    "test": "npm test --workspace resources/app/api",
    "lint": "npm run lint --workspace resources/app",
    "package": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron-builder": "^24.9.1"
  }
}
