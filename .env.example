PORT=5000
JWT_SECRET=
JWT_EXPIRATION=7d

# SMTP via Resend (Nodemailer)
# Resend exige um domínio verificado antes de aceitar mensagens SMTP.
# Não use Gmail como remetente nem um domínio não verificado.
# Para testes rápidos, o Resend pode limitar destinatários a onboarding@resend.dev;
# para produção, adicione e verifique o domínio próprio em https://resend.com/domains
# e configure os registros DNS mostrados pelo painel.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_PASSWORD=your_resend_api_key_here
SMTP_FROM=no-reply@seu-dominio.com
SMTP_FROM_EMAIL=no-reply@seu-dominio.com
SMTP_SECURE=true

# Resend HTTP API (compatibilidade; o projeto prioriza SMTP/Nodemailer)
# No Vercel, configure as mesmas variáveis em Project Settings > Environment Variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@seu-dominio.com
RESEND_FROM_NAME=Mertilo

# Opcional para diagnosticar o envio real via smtpdiag.mjs
SMTP_TEST_RECIPIENT=seu-email@dominio.com

MERTILO_DATA_DIR=
MERTILO_DB_PATH=
